{
  "name": "bank-frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "generate:apis": "npm run generate:employee-api && npm run generate:customer-api",
    "generate:employee-api": "openapi-generator-cli generate -c openapi/config/employee-openapi-generator-config.yaml && npm run generate:employee-constraints",
    "generate:employee-constraints": "node scripts/generate-form-constraints.mjs employee",
    "generate:customer-api": "openapi-generator-cli generate -c openapi/config/customer-openapi-generator-config.yaml && npm run generate:customer-constraints",
    "generate:customer-constraints": "node scripts/generate-form-constraints.mjs customer",
    "test:form-constraints": "node --test scripts/generate-form-constraints.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "keycloak-angular": "^22.0.0",
    "keycloak-js": "^26.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "2.42.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.1.0"
  }
}
